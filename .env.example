# Telegram: @BotFather
BOT_TOKEN=your_telegram_bot_token

# TronFees backend (TELEGRAM_BOT_API.md)
TRONFEES_SERVICE_API_KEY=your_tronfees_service_api_key
# Optional override:
# TRONFEES_API_BASE_URL=https://tron-fees-api.tronpay.me

# Backend → bot webhook (delegation order status)
# Set WEBHOOK_ENABLED=true in production; same secret as TRONFEES_BOT_WEBHOOK_SECRET on backend
WEBHOOK_ENABLED=false
WEBHOOK_PORT=3000
WEBHOOK_SECRET=your_shared_webhook_secret
# WEBHOOK_DEDUP_TTL_MS=86400000
#
# Stage deploy: container tronfees-bot on external network tronfees-net (same as API compose)
# Host webhook: 127.0.0.1:3000 → container:3000
# Bot → API (GitHub secret TRONFEES_API_BASE_URL), e.g. http://tronfees-api:8080
# API → bot webhook: http://tronfees-bot:3000/webhooks/delegation-order

# Analytics funnel events → self-hosted Umami.
# ВСЁ УЖЕ НАСТРОЕНО ПО УМОЛЧАНИЮ в src/analytics/umami.js:
#   URL http://umami:3000, website "TronVolt Bot" находится/создаётся автоматически
#   через дефолтный логин admin/umami. Ничего задавать не нужно.
# Ниже — только переопределения на случай нестандартной установки:
# UMAMI_ENABLED=true            # включить (stage workflow выставляет сам)
# UMAMI_URL=http://umami:3000   # адрес инстанса Umami
# UMAMI_WEBSITE_ID=             # задай явно, если сменил пароль админа Umami
# UMAMI_ADMIN_USER=admin        # админ-логин для автообнаружения website
# UMAMI_ADMIN_PASSWORD=umami    # админ-пароль для автообнаружения website
# UMAMI_HOSTNAME=tronvolt-bot

# Еженедельная сводка воронки владельцу в Telegram (понедельник 10:00 UTC).
# Включается заданием UMAMI_DATABASE_URL (stage workflow пробрасывает секрет).
# UMAMI_DATABASE_URL=postgresql://... (база umami на том же DO-кластере)
# OWNER_TELEGRAM_ID=1124839901   # кому слать сводку (по умолчанию — владелец)
# WEEKLY_REPORT_SEND_NOW=false   # true → отправить сразу при старте (для проверки)

# Мониторинг баланса CatFee: проверка после каждого исполненного/упавшего
# заказа + фоном раз в 6 часов; алерт владельцу, если баланс ниже порога
# (напоминания не чаще раза в 6 часов).
# CATFEE_WATCH_ENABLED=true
# CATFEE_LOW_BALANCE_TRX=30
